# Signal MCP server — set these on the Vercel project (Production + Preview).
# The MCP never sees database credentials: everything goes through this API.

# Base URL of the Signal public facts API (the Railway backend).
SIGNAL_API_URL=https://stackenhance-backend-production.up.railway.app

# Shared key that puts MCP traffic on its own rate-limit tier. Must match
# SIGNAL_MCP_KEY on the Railway backend service. Optional: unset = anonymous tier.
SIGNAL_MCP_KEY=
